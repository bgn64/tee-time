{
  "name": "my-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:db": "jest --selectProjects db --runInBand",
    "test:all": "jest",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/lib/**/*.test.ts",
          "<rootDir>/components/__tests__/**/*"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native(-.*)?|@react-native(-community)?|expo(-.*)?|@expo(nent)?(/.*)?|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@supabase)/)"
        ]
      },
      {
        "displayName": "db",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/supabase/tests/**/*.test.ts"
        ],
        "setupFiles": [
          "<rootDir>/supabase/tests/setup.ts"
        ],
        "transform": {
          "^.+\\.tsx?$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        }
      }
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.105.4",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.1.0",
    "dotenv": "^17.4.2",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.34.5",
    "supabase": "^2.98.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
