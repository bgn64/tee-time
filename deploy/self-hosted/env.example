
# App-specific overrides appended to the official Supabase .env on first prepare.
# Edit the generated file on the server, not this template.
SITE_URL=https://app.example.invalid
ADDITIONAL_REDIRECT_URLS=
SUPABASE_PUBLIC_URL=https://api.example.invalid
API_EXTERNAL_URL=https://api.example.invalid/auth/v1
STUDIO_DEFAULT_ORGANIZATION=Tee Time
STUDIO_DEFAULT_PROJECT=Tee Time
OPENAI_API_KEY=
DISABLE_SIGNUP=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
SMTP_HOST=configure-smtp.example.invalid
SMTP_PORT=587
SMTP_ADMIN_EMAIL=configure-sender@example.invalid
SMTP_USER=configure-smtp-user
SMTP_PASS='configure-smtp-password'
SMTP_SENDER_NAME=Tee Time
TEE_TIME_WEB_PORT=8088
TEE_TIME_API_PORT=8089
TEE_TIME_ADMIN_PORT=8000
