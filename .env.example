# Copy to .env.local and fill in. Never commit .env.local — the service
# role key bypasses RLS and is treated as a high-sensitivity secret.
#
# Default local-dev values: point at the local Supabase Docker stack
# (npx supabase start). The CLI prints the anon and service-role keys
# the first time it boots — copy them here.

# ----- Metro / web client (Expo inlines EXPO_PUBLIC_* at build time) -----
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ----- Node scripts (scripts/ingest-opengolf.ts, scripts/seed-test-users.ts) -----
# Service role key bypasses RLS. Local-Docker value is fine here; never
# put staging/prod service-role keys in .env.local — those live in
# GitHub Actions secrets or are pasted into one-off shells when needed.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Project ref of the production Supabase project. Used as a safety
# guard inside destructive scripts (seed-test-users.ts) — they refuse
# to run if SUPABASE_URL points at this ref. Get it from the dashboard
# URL: https://supabase.com/dashboard/project/<ref>.
PRODUCTION_PROJECT_ID=

# ----- Web: Google Maps embed -----
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ----- DB integration tests (live in a separate .env.test file) -----
# `supabase/tests/setup.ts` loads .env.test (not .env.local). Create
# .env.test at the repo root with these three values, all from
# `npx supabase start`:
#   SUPABASE_TEST_URL=http://127.0.0.1:54321
#   SUPABASE_TEST_ANON_KEY=...
#   SUPABASE_TEST_SERVICE_ROLE_KEY=...
