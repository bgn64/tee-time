{
  "expo": {
    "name": "Tee Time",
    "slug": "tee-time",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon-modern-scorecard.png",
    "scheme": "teetime",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-modern-scorecard.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f7f2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bgalindonavarro.teetime",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-modern-scorecard.png",
        "backgroundColor": "#2f7d4b"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Tee Time to use your location to find golf courses near you and measure distances on the course.",
          "locationWhenInUsePermission": "Allow Tee Time to use your location to find golf courses near you and measure distances on the course.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0117025-f312-4e22-8052-211c0649ed80"
      }
    },
    "owner": "bgn64",
    "updates": {
      "url": "https://u.expo.dev/f0117025-f312-4e22-8052-211c0649ed80"
    }
  }
}
